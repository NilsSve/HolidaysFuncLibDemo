//****************************************************************************
// $Module type: Class Package
// $Module name: cFlagHtmlBox.pkg
// $Author     : Nils Svedmyr, RDC Tools International
// Created     : 2026-11-23
//
// Description : A nation's flag, shown as HTML in a FlexTron box - in place of the Graphics Library's
//               cDbImageContainer, which the demo used until then (Is$GraphicsLibrary, off by default).
//
// This code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
//****************************************************************************
Use cViewHtmlBox.pkg             // the view's colour around the flag
Use FTMarkupBuilders.pkg       // FTHtmlEscape
Use cCharTranslate.pkg         // Base64EncodeToStr
Use seq_chnl.pkg

/* THE FLAG. The Nations table names each nation's flag file in Nations.Flag ("Sweden.gif"), and the files are in
   folders of their own under the workspace's Bitmaps folder - FlagsPNG and FlagsGIF (psFlagFolders). The
   box shows the file as an <img> whose address is the file itself, base64 encoded (a data: address),
   so the files stay where they are - nothing is copied under AppHtml, which is all a FlexTron page can reach by a
   path. The way RDCFlexTron's About dialog shows its picture. A view sends ShowFlag whenever its record
   changes: from the Refresh of a data entry object on the Nations table, which runs on every find, clear and relate. */
{ OverrideProperty=psHtml InitialValue="<div class='ftph-cards'><b>Flag</b></div>" }
Class cFlagHtmlBox is a cViewHtmlBox

    Procedure Construct_Object
        Forward Send Construct_Object
        Set psHtml to "<div class='ftph-cards'><b>Flag</b></div>"

        Property Integer piHeight 72
        Property Integer piWidth 90

        // THE FLAG FOLDERS: sub folders of the bitmap path's folders, separated by ";", searched in this order after
        // the folders themselves. Not on the bitmap path itself (Nils 2026-11-25): the workspace's .sws holds ONE
        // bitmap folder - df-cli installs the libraries' icons into it, and with several it installs them into a
        // folder named after the whole list - and every other image the program looks up would search the flags too.
        // FlagsSVG holds the flag-icons set (MIT, LICENSE-flag-icons.txt), named by the ISO code: se.svg.
        Property String psFlagFolders "FlagsSVG;FlagsPNG;FlagsGIF"

        // The file shown, so that the same flag is not read and sent again on every refresh.
        { Visibility=Private }
        Property String private.psFlagFile "-"
    End_Procedure

    // The full path of a flag file, or "": in each folder of the workspace's bitmap path, then in its flag folders
    // (psFlagFolders) - Bitmaps\Sweden.png, then Bitmaps\FlagsPNG\Sweden.png, then Bitmaps\FlagsGIF\Sweden.png.
    Function BitmapFile String sFile Returns String
        String[] asFolders asSubs
        String sFolder sPath
        Integer iFolder iSub
        Boolean bExists
        Move (Trim(sFile)) to sFile
        If (sFile = "") ;
            Function_Return ""
        Move (StrSplitToArray(psBitmapPath(phoWorkspace(ghoApplication)), ";")) to asFolders
        // "" first: the folder itself
        Move "" to asSubs[0]
        Move (AppendArray(asSubs, StrSplitToArray(psFlagFolders(Self), ";"))) to asSubs
        For iFolder from 0 to (SizeOfArray(asFolders) - 1)
            Move (Trim(asFolders[iFolder])) to sFolder
            If (sFolder <> "") Begin
                If (Right(sFolder, 1) <> "\") ;
                    Move (sFolder + "\") to sFolder
                For iSub from 0 to (SizeOfArray(asSubs) - 1)
                    Move (Trim(asSubs[iSub])) to sPath
                    If (sPath <> "") ;
                        Move (sPath + "\") to sPath
                    Move (sFolder + sPath + sFile) to sPath
                    File_Exist sPath bExists
                    If (bExists) ;
                        Function_Return sPath
                Loop
            End
        Loop
        Function_Return ""
    End_Function

    // The file as a data: address - "data:image/gif;base64,R0lGOD..." - or "" when it cannot be read.
    Function ImageDataUrl String sPath Returns String
        UChar[] ucaData
        String sMime sLow sData
        Integer iCh
        Handle hoTrans
        Move (Lowercase(sPath)) to sLow
        Move "image/gif" to sMime
        If (Right(sLow, 4) = ".png") ;
            Move "image/png" to sMime
        If ((Right(sLow, 4) = ".jpg") or (Right(sLow, 5) = ".jpeg")) ;
            Move "image/jpeg" to sMime
        // a drawing, not pixels: sharp at any size
        If (Right(sLow, 4) = ".svg") ;
            Move "image/svg+xml" to sMime
        Move (Seq_New_Channel()) to iCh
        If (iCh < 0) ;
            Function_Return ""
        Direct_Input channel iCh ("binary:" + sPath)
        Read_Block channel iCh ucaData -1
        Close_Input channel iCh
        Send Seq_Release_Channel iCh
        If (SizeOfArray(ucaData) = 0) ;
            Function_Return ""
        Get Create (RefClass(cCharTranslate)) to hoTrans
        Get Base64EncodeToStr of hoTrans (AddressOf(ucaData)) (SizeOfArray(ucaData)) to sData
        Send Destroy of hoTrans
        Function_Return ("data:" + sMime + ";base64," + sData)
    End_Function

    // Show a nation's flag: sFile as Nations.Flag names it, sName for its tooltip. No file, or none found: an empty
    // frame.
    // ToDo: There needs to be a way to set the size of the flag!
    Procedure ShowFlag String sFile String sName
        String sPath sUrl sHtml
        Integer iWidth iHeight

        Move (Trim(sFile)) to sFile
        If (sFile = private.psFlagFile(Self)) ;
            Procedure_Return
        Set private.psFlagFile to sFile

        Get piWidth to iWidth
        Get piHeight to iHeight

        Get BitmapFile sFile to sPath
        If (sPath <> "") ;
            Get ImageDataUrl sPath to sUrl
        Move '<div style="display:flex;align-items:center;justify-content:center;height:100%;min-height:60px">' to sHtml
        If (sUrl <> "") ;
            Append sHtml '<img src="' sUrl '" alt="' (FTHtmlEscape(sName)) '" title="' (FTHtmlEscape(sName)) ;
                '" style="width:min(100%,' (String(iWidth)) 'px);height:' (String(iHeight)) ;
                'px;object-fit:contain;border:1px solid var(--dfr-line-card,#3a3936);border-radius:3px">'
        Else ;
            Append sHtml '<div style="width:72px;height:48px;border:1px dashed var(--dfr-line-card,#3a3936);border-radius:3px" title="No flag"></div>'
        Send ShowHtml (sHtml + "</div>")
    End_Procedure

End_Class
