# Files to be ignored by git in a DataFlex workspace

# Libraries are NOT stored in this repo. setup.bat provides them: on a machine
# with the shared RDC library pool it makes Libraries\ a junction to it (one
# shared, editable copy); otherwise it clones isolated copies inside. Either
# way the folder is local-only, never committed. (Do not git clean -x it.)
/Libraries/

# AppHtml
**/apphtml/global.asa

# AppSrc
**/AppSrc/**/*.prn
**/AppSrc/**/*.dep
**/AppSrc/**/*.dbg
**/AppSrc/**/*.exe.manifest
**/AppSrc/**/*.exe-*.manifest
**/AppSrc/**/*.manifest.Backup
**/AppSrc/**/*.err
**/AppSrc/**/*.fld
**/AppSrc/**/*.pbg
**/AppSrc/**/*.pdp
**/AppSrc/**/*.pkd
**/AppSrc/**/*.prn
**/AppSrc/**/*.prp
loginEncryptionkey.inc

# Data
**/Data/**/*.log
**/Data/**/*.dat
**/Data/**/*.vld
**/Data/**/*.k*
**/Data/**/*.bad
**/Data/**/*.hdr
**/Data/**/*.cch
**/Data/**/*.cfg

# DDSrc
**/DdSrc/**/*.def

# IdeSrc
**/IdeSrc/*.dsk
**/IdeSrc/*.loc
**/IdeSrc/*.mtd

# Programs
**/Programs/*.dbg
**/Programs/*.exe
**/Programs/*.exe.manifest
# CodeJock controls COM Manifest Studio copies beside the program (registration-free COM) - vendor files
**/Programs/*.ocx
**/Programs/*.log

# Workspace specific
**/Help/**/*.hnd
**/Help/**/Assets
**/Help/**/Online Help
**/HelpText**/*.*
**/Install
**/Capture
# DataFlex 26 package cache: what df-cli installs for HolidaysFuncLibDemo.sws (filled again from the .sws.lock)
/DfPkg/
